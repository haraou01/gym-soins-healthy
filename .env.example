# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=password_change_in_production
POSTGRES_DATABASE=gymsoins
# Rôle runtime RLS (jamais propriétaire des tables). À bootstrapper via
# `npm run bootstrap:db-roles` avec APP_DB_PASSWORD.
POSTGRES_RUNTIME_USERNAME=gymsoins_app
POSTGRES_RUNTIME_PASSWORD=change_me_app_runtime_password
APP_DB_PASSWORD=change_me_app_runtime_password
WORKER_DB_USERNAME=gymsoins_worker
WORKER_DB_PASSWORD=change_me_worker_runtime_password
RETENTION_DB_USERNAME=gymsoins_retention
RETENTION_DB_PASSWORD=change_me_retention_runtime_password

# Tests E2E (optionnel — les tests utilisent ces variables si présentes)
# TEST_PG_HOST=localhost
# TEST_PG_PORT=55432
# TEST_PG_USER=gymsoins
# TEST_PG_PASSWORD=gymsoins
# TEST_PG_DATABASE=gymsoins_test

# Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production

# HTTP / production hardening
# En production, CORS_ORIGINS est obligatoire et JWT_SECRET doit faire >= 32 caractères.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false
OBSERVABILITY_LOG_ENABLED=true
METRICS_TOKEN=change_me_metrics_token_at_least_16_chars
APP_VERSION=1.0.0
GIT_COMMIT=unknown
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300

# Rate limiting distribué (compteurs PostgreSQL, multi-instance)
AUTH_LOGIN_EMAIL_MAX_ATTEMPTS=20
AUTH_LOGIN_IP_MAX_ATTEMPTS=30
AUTH_LOGIN_RATE_WINDOW_SECONDS=60
AUTH_REGISTER_EMAIL_MAX_ATTEMPTS=5
AUTH_REGISTER_IP_MAX_ATTEMPTS=5
AUTH_REGISTER_RATE_WINDOW_SECONDS=3600
AUTH_REFRESH_IP_MAX_ATTEMPTS=30
AUTH_REFRESH_RATE_WINDOW_SECONDS=60

# Rétention / purge par lots
# L'API ne doit pas exécuter la rétention en production :
# RETENTION_PURGE_ENABLED=false sur l'API, puis `npm run start:retention`.
RETENTION_PURGE_ENABLED=false
RETENTION_PURGE_INTERVAL_MS=21600000
RETENTION_PURGE_MAX_BATCHES=20
IDEMPOTENCY_RETENTION_DAYS=30
IDEMPOTENCY_PURGE_BATCH_SIZE=500
OUTBOX_RETENTION_DAYS=30
OUTBOX_PURGE_BATCH_SIZE=500
RETENTION_WORKER_HEALTH_HOST=127.0.0.1
RETENTION_WORKER_HEALTH_PORT=3003

# Outbox / worker durable
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=5000
OUTBOX_MAX_BACKOFF_MS=300000
OUTBOX_LOCK_TIMEOUT_MS=300000

# Worker Outbox dédié
# En production multi-process : OUTBOX_WORKER_ENABLED=false sur l'API,
# puis lancer `npm run start:worker`.
WORKER_HEALTH_HOST=127.0.0.1
WORKER_HEALTH_PORT=3002

# OpenTelemetry (désactivé par défaut)
OTEL_ENABLED=false
OTEL_SERVICE_NAME=gymsoins-healthy
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_TIMEOUT_MS=10000
OTEL_BSP_SCHEDULE_DELAY=5000

# Licencing & Anti-Distribution
LICENSE_KEY_FORMAT={username}-{id}
LICENSE_SECRET=your_license_secret_change_in_production
LICENSE_DEFAULT_TTL_DAYS=365
# Mode développement : renvoie les 7 modules sans clé (mettre false en production)
LICENSE_DEV_MODE=true
# Licence active (optionnel : peut aussi être envoyée via x-license-key / x-hardware-id)
LICENSE_KEY=
LICENSE_HARDWARE_ID=
API_VERSION="3.0"
EXPIRATION_CHECK_INTERVAL=60
ANTI_DIST_ENABLED=true
ENCRYPTION_LEVEL=AES256
LICENSE_ALGORITHM=RS256
SIGNATURE_ALGORITHM=SHA-256

# Gym Module
BILLING_INTERVAL=monthly
TRIAL_PERIOD_DAYS=7
GYM_MAX_CAPACITY=1000
GROUP_MAX_MEMBERS=30
TIME_SLOTS_PER_DAY=16
