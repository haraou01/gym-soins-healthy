# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=admin
POSTGRES_PASSWORD=password_change_in_production
POSTGRES_DATABASE=gymsoins

# Tests E2E (optionnel — les tests utilisent ces variables si présentes)
# TEST_PG_HOST=localhost
# TEST_PG_PORT=55432
# TEST_PG_USER=gymsoins
# TEST_PG_PASSWORD=gymsoins
# TEST_PG_DATABASE=gymsoins_test

# Redis & Bull Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Security & JWT
JWT_SECRET=your_jwt_secret_change_in_production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production

# HTTP / production hardening
# En production, CORS_ORIGINS est obligatoire et JWT_SECRET doit faire >= 32 caractères.
CORS_ORIGINS=http://localhost:5173,tauri://localhost,http://tauri.localhost
REQUEST_BODY_LIMIT=1mb
TRUST_PROXY=false
OBSERVABILITY_LOG_ENABLED=true

# Outbox / worker durable
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=2000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BASE_BACKOFF_MS=5000
OUTBOX_MAX_BACKOFF_MS=300000
OUTBOX_LOCK_TIMEOUT_MS=300000

# Licencing & Anti-Distribution
LICENSE_KEY_FORMAT={username}-{id}
LICENSE_SECRET=your_license_secret_change_in_production
LICENSE_DEFAULT_TTL_DAYS=365
# Mode développement : renvoie les 7 modules sans clé (mettre false en production)
LICENSE_DEV_MODE=true
# Licence active (optionnel : peut aussi être envoyée via x-license-key / x-hardware-id)
LICENSE_KEY=
LICENSE_HARDWARE_ID=
API_VERSION="3.0"
EXPIRATION_CHECK_INTERVAL=60
ANTI_DIST_ENABLED=true
ENCRYPTION_LEVEL=AES256
LICENSE_ALGORITHM=RS256
SIGNATURE_ALGORITHM=SHA-256

# Gym Module
BILLING_INTERVAL=monthly
TRIAL_PERIOD_DAYS=7
GYM_MAX_CAPACITY=1000
GROUP_MAX_MEMBERS=30
TIME_SLOTS_PER_DAY=16
