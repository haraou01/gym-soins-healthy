# URL du backend NestJS (par défaut : proxy Vite /api en développement)
VITE_API_BASE_URL=http://localhost:3000

# Licence Plug-and-Play (optionnel)
# Laisser VIDE en développement local : le backend (LICENSE_DEV_MODE) renvoie
# alors les 7 modules et tous les menus/pages sont débloqués.
# Renseigner une clé pour tester le filtrage réel par licence.
VITE_LICENSE_KEY=
VITE_HARDWARE_ID=

# En développement, tous les modules sont débloqués par défaut par le frontend.
# Pour tester le filtrage par licence, passer à true ET démarrer le backend avec
# LICENSE_DEV_MODE=false (sinon l'API renvoie aussi les 7 modules).
VITE_LICENSE_ENFORCE=false
