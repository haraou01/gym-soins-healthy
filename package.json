{
  "name": "gym-soins-healthy",
  "version": "1.0.0",
  "description": "Gestion de salle de sport et bien-être - SaaS modulaire avec NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "nest": "nest start --watch",
    "dev": "nest start ts-node",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:baseline": "node scripts/migrate.js --baseline",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/bull": "^10.2.3",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^3.0.3",
    "bull": "^4.12.2",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.1",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "redis": "^4.6.13",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@types/bull": "^4.9.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.0",
    "@types/passport-jwt": "^3.0.8",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "gym",
    "salle-sport",
    "soins",
    "booking",
    "gestion",
    "nlp",
    "healthcare",
    "nestjs",
    "typeorm",
    "redis",
    "bull-queue",
    "RBAC",
    "SaaS"
  ],
  "author": "",
  "license": "ISC"
}
