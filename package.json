{
  "name": "gym-soins-healthy",
  "version": "1.0.0",
  "description": "Gestion de salle de sport et bien-\u00eatre - SaaS modulaire avec NestJS",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:retention": "node dist/retention-worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "retention:dev": "ts-node src/retention-worker.ts",
    "nest": "nest start --watch",
    "dev": "nest start ts-node",
    "db:migrate": "node scripts/migrate.js",
    "db:migrate:baseline": "node scripts/migrate.js --baseline",
    "bootstrap:db-roles": "node scripts/bootstrap-db-roles.js",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "verify:restore": "node scripts/verify-restore.js",
    "smoke:restore": "node scripts/smoke-restore.js",
    "audit:secrets": "node scripts/audit-secrets.js",
    "load:test": "node scripts/load-test.js",
    "verify:otel": "node scripts/verify-otel.js",
    "verify:kds-sse": "node scripts/verify-kds-tenant-sse.js",
    "verify:ui": "node scripts/verify-ui-tenant.js",
    "validate:ops": "node scripts/validate-ops.js",
    "db:test:up": "docker compose -f docker-compose.test.yml up -d --wait",
    "db:test:down": "docker compose -f docker-compose.test.yml down -v",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "load:test:multi": "node scripts/load-test-multitenant.js",
    "verify:app-rls": "node scripts/verify-app-rls-smoke.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/event-emitter": "^2.1.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/typeorm": "^10.0.2",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-express": "^0.71.1",
    "@opentelemetry/instrumentation-http": "^0.223.0",
    "@opentelemetry/instrumentation-nestjs-core": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.76.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "bcryptjs": "^3.0.3",
    "class-validator": "^0.14.0",
    "dotenv": "^16.6.1",
    "helmet": "^7.2.0",
    "joi": "^17.13.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.12.0",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.4.22",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.12.0",
    "@types/passport-jwt": "^3.0.8",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "playwright-core": "^1.64.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "keywords": [
    "gym",
    "salle-sport",
    "soins",
    "booking",
    "gestion",
    "nlp",
    "healthcare",
    "nestjs",
    "typeorm",
    "RBAC",
    "SaaS"
  ],
  "author": "",
  "license": "ISC",
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0",
    "qs": "6.16.1",
    "lodash": "4.18.1",
    "uuid": "11.1.1"
  }
}
